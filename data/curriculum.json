  "a1.akk.mask": {
   "title": "Akkusativ masculino",
   "requires": [
    "a1.nom.mask"
   ],
   "orthographic": false,
   "rule": "Con *brauchen*, *haben* y *möchten* el objeto va en *Akkusativ* (objeto directo): el artículo depende del género del sustantivo, y solo uno de los tres géneros cambia respecto del *Nominativ*.",
   "examples": [
    {
     "de": "Ich brauche einen Löffel.",
     "es": "Necesito una cuchara.",
     "dims": {
      "gender": "m"
     }
    },
    {
     "de": "Ich habe eine Tasche.",
     "es": "Tengo un bolso.",
     "dims": {
      "gender": "f"
     }
    },
    {
     "de": "Ich möchte ein Brot.",
     "es": "Quiero un pan.",
     "dims": {
      "gender": "n"
     }
    }
   ]
  },
