 "tags": {
  "a1.pron.personal": {
   "title": "Pronombres personales",
   "requires": [],
   "orthographic": false,
   "rule": "Los *Personalpronomen* (pronombres personales) reemplazan al sujeto y hay uno distinto para cada persona; el trato formal se escribe con mayúscula.",
   "examples": [
    {
     "de": "Ich bin müde.",
     "es": "Estoy cansado.",
     "dims": {
      "person": "ich"
     }
    },
    {
     "de": "Du bist im Hostel.",
     "es": "Estás en el hostel.",
     "dims": {
      "person": "du"
     }
    },
    {
     "de": "Er kommt aus Brasilien.",
     "es": "Él viene de Brasil.",
     "dims": {
      "person": "er"
     }
    },
    {
     "de": "Wir sind im Zimmer.",
     "es": "Estamos en el cuarto.",
     "dims": {
      "person": "wir"
     }
    }
   ],
   "curiosities": [
    "*du* y el inglés antiguo *thou* vienen de la misma raíz germánica."
   ]
  },
  "a1.sein.praesens": {
   "title": "sein en presente",
   "requires": [
    "a1.pron.personal"
   ],
   "orthographic": false,
   "rule": "El verbo *sein* (ser/estar) es irregular: cambia con cada persona y sirve tanto para ser como para estar.",
   "examples": [
    {
     "de": "Ich bin neu hier.",
     "es": "Soy nuevo acá.",
     "dims": {
      "person": "ich"
     }
    },
    {
     "de": "Du bist im Hostel.",
     "es": "Estás en el hostel.",
     "dims": {
      "person": "du"
     }
    },
    {
     "de": "Wir sind in der Küche.",
     "es": "Estamos en la cocina.",
     "dims": {
      "person": "wir"
     }
    },
    {
     "de": "Sie ist an der Rezeption.",
     "es": "Ella está en la recepción.",
     "dims": {
      "person": "sie"
     }
    }
   ],
   "curiosities": [
    "*sein* es irregular, igual que *to be* en inglés y *ser* en español y portugués."
   ]
  },
  "a1.wfragen": {
   "title": "W-Fragen",
   "requires": [],
   "orthographic": false,
   "rule": "Las *W-Fragen* (preguntas con palabra interrogativa) empiezan con esa palabra y el verbo conjugado va enseguida, en segunda posición.",
   "examples": [
    {
     "de": "Wer ist das?",
     "es": "¿Quién es?",
     "dims": {
      "word": "wer"
     }
    },
    {
     "de": "Was ist das?",
     "es": "¿Qué es esto?",
     "dims": {
      "word": "was"
     }
    },
    {
     "de": "Wo ist die Küche?",
     "es": "¿Dónde está la cocina?",
     "dims": {
      "word": "wo"
     }
    },
    {
     "de": "Woher kommst du?",
     "es": "¿De dónde sos?",
     "dims": {
      "word": "woher"
     }
    },
    {
     "de": "Wie heißt du?",
     "es": "¿Cómo te llamás?",
     "dims": {
      "word": "wie"
     }
    }
   ],
   "curiosities": [
    "Casi todas las palabras interrogativas alemanas empiezan con *w*, como *who*, *what* y *where* en inglés."
   ]
  },
  "a1.nom.mask": {
   "title": "Nominativ masculino",
   "requires": [],
   "orthographic": false,
   "rule": "En *Nominativ* (el sujeto) cada sustantivo trae el artículo de su género, que se aprende con la palabra o se deduce de sus pistas (terminación, palabra compuesta, *-chen*, plural).",
   "examples": [
    {
     "de": "Der Löffel ist neu.",
     "es": "La cuchara es nueva.",
     "dims": {
      "gender": "m"
     }
    },
    {
     "de": "Die Lampe ist im Zimmer.",
     "es": "La lámpara está en el cuarto.",
     "dims": {
      "gender": "f"
     }
    },
    {
     "de": "Das Bett ist groß.",
     "es": "La cama es grande.",
     "dims": {
      "gender": "n"
     }
    }
   ]
  },
